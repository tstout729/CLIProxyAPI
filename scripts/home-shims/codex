#!/bin/sh
# Interactive codex on the home host: run through this machine's CLIProxyAPI
# (shared account pool). cmux's own codex wrapper resolves to this file.
[ "$#" -gt 0 ] && [ "$1" = resume ] && [ "codex" = claude ] && { shift; set -- --resume "$@"; }
exec /opt/homebrew/bin/python3 "$HOME/.local/bin/home-coding-session" run codex -- "$@"
