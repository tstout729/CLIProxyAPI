# Ghostty on the laptop: every window is a view of the home host's tabs.
# Install as ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# (cmux does not read that file), then reload with Cmd+Shift+Comma.

# Every window runs on the home host (M1): mosh + tmux (scripts/m1-terminal.sh).
command = /Users/trevorstout/.local/bin/m1
# Reopen windows after quitting; each one shows the tab list again.
window-save-state = always
# The window's thin margin takes the color of the cells beside it, so the sidebar
# panel runs to the window edge instead of showing a lighter strip.
window-padding-color = extend
# mosh does not pass modified keys; send Meta+Enter so Shift+Enter adds a newline in Claude.
keybind = shift+enter=text:\x1b\r

# Tabs live on the home host and are listed on the left of each window (scripts/m1-sidebar.py).
# These keys send the tabs server's tmux prefix (Ctrl+B, \x02) and a key from m1-tabs.tmux.conf.
keybind = super+n=text:\x02c
keybind = super+t=text:\x02c
keybind = super+w=text:\x02X
keybind = super+shift+r=text:\x02,
keybind = super+shift+u=text:\x02u
keybind = super+shift+]=text:\x02n
keybind = super+shift+[=text:\x02p
keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02p
keybind = super+1=text:\x021
keybind = super+digit_1=text:\x021
keybind = super+2=text:\x022
keybind = super+digit_2=text:\x022
keybind = super+3=text:\x023
keybind = super+digit_3=text:\x023
keybind = super+4=text:\x024
keybind = super+digit_4=text:\x024
keybind = super+5=text:\x025
keybind = super+digit_5=text:\x025
keybind = super+6=text:\x026
keybind = super+digit_6=text:\x026
keybind = super+7=text:\x027
keybind = super+digit_7=text:\x027
keybind = super+8=text:\x028
keybind = super+digit_8=text:\x028
keybind = super+9=text:\x029
keybind = super+digit_9=text:\x029
# A second window (another view of the same tabs) and closing a window keep Shift.
keybind = super+shift+n=new_window
keybind = super+shift+w=close_window
